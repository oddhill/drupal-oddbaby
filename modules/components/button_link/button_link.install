<?php

/**
 * @file
 * Install/update hooks for Button Link.
 */

/**
 * Implements hook_install().
 */
function button_link_install(): void {
  _button_link_ensure_cta_field_storage();
}

/**
 * Ensure field storage exists for field_button_variant.
 */
function button_link_update_9001(): void {
  _button_link_ensure_cta_field_storage();
}

/**
 * Sync Font Awesome icons list into field_button_icon allowed values.
 */
function button_link_update_9002(): void {
  $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('paragraph', 'field_button_icon');
  if (!$storage) {
    return;
  }

  // Only applies to list_string.
  if ($storage->getType() !== 'list_string') {
    return;
  }

  $allowed_values = button_link_get_fontawesome_icon_allowed_values();
  if (!$allowed_values) {
    // If the JSON index isn't present yet, don't wipe existing values.
    return;
  }

  $settings = $storage->getSettings();
  $settings['allowed_values'] = $allowed_values;
  $storage->set('settings', $settings)->save();
}

/**
 * Create the field storage for field_button_variant if missing.
 */
function _button_link_ensure_cta_field_storage(): void {
  $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('paragraph', 'field_button_variant');
  if ($storage) {
    return;
  }

  \Drupal\field\Entity\FieldStorageConfig::create([
    'field_name' => 'field_button_variant',
    'entity_type' => 'paragraph',
    'type' => 'list_string',
    'cardinality' => 1,
    'settings' => [
      'allowed_values' => [
        'link' => 'Link',
        'button' => 'Button',
      ],
    ],
  ])->save();
}
