<?php

use Drupal\paragraphs\Entity\ParagraphsType;

/**
 * Implements hook_install().
 */
function paragraph_media_with_text_install() {
  // Create the paragraph type if it doesn't exist.
  $paragraph_type = ParagraphsType::load('media_with_text');
  if (!$paragraph_type) {
    $paragraph_type = ParagraphsType::create([
      'id' => 'media_with_text',
      'label' => 'Media + Text',
      'description' => 'Paragraph with media left and text+button right.',
    ]);
    $paragraph_type->save();
  }

  // Ensure fields exist and are enabled in both Form display and Manage display.
  _paragraph_media_with_text_add_fields($paragraph_type);
  _paragraph_media_with_text_enable_fields_in_form_display($paragraph_type);
  _paragraph_media_with_text_enable_fields_in_view_display($paragraph_type);
}

/**
 * Restrict the Media reference field to specific Media types.
 */
function paragraph_media_with_text_update_9001() {
  $field_config = \Drupal\field\Entity\FieldConfig::load('paragraph.media_with_text.field_media');
  if (!$field_config) {
    return;
  }

  $allowed_media_bundles = [
    'document' => 'document',
    'graphic' => 'graphic',
    'image' => 'image',
    'remote_video' => 'remote_video',
  ];

  $settings = $field_config->getSettings();
  $settings['handler'] = 'default:media';
  $settings['handler_settings'] = $settings['handler_settings'] ?? [];
  $settings['handler_settings']['target_bundles'] = $allowed_media_bundles;
  $field_config->set('settings', $settings)->save();
}

/**
 * Use the Media Library widget (Add media button) for field_media.
 */
function paragraph_media_with_text_update_9002() {
  if (!\Drupal::moduleHandler()->moduleExists('media_library')) {
    \Drupal::service('module_installer')->install(['media_library'], TRUE);
  }

  $form_display = \Drupal\Core\Entity\Entity\EntityFormDisplay::load('paragraph.media_with_text.default');
  if (!$form_display) {
    return;
  }

  $form_display->setComponent('field_media', [
    'type' => 'media_library_widget',
    'weight' => 0,
    'region' => 'content',
    'settings' => [
      'media_types' => [
        'document',
        'graphic',
        'image',
        'remote_video',
      ],
    ],
    'third_party_settings' => [],
  ]);

  $form_display->save();
}

