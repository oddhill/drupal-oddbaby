/**
 * Group Call-to-Action fields on the edit form (Field Group).
 */
function paragraph_media_with_text_update_9006(): void {
  if (!\Drupal::moduleHandler()->moduleExists('field_group')) {
    return;
  }

  $form_display = \Drupal\Core\Entity\Entity\EntityFormDisplay::load('paragraph.media_with_text.default');
  if (!$form_display) {
    return;
  }

  $group_key = 'group_call_to_action';
  $groups = $form_display->getThirdPartySettings('field_group');

  $groups[$group_key] = [
    'children' => [
      'field_button_link',
      'field_button_variant',
      'field_button_new_window',
      'field_button_icon',
      'field_button_icon_position',
    ],
    'label' => 'Call-to-Action',
    'description' => '',
    'parent_name' => '',
    'weight' => 20,
    'format_type' => 'details',
    'format_settings' => [
      'open' => TRUE,
      'required_fields' => TRUE,
      'classes' => '',
      'id' => '',
    ],
    'region' => 'content',
  ];

  $form_display->setThirdPartySetting('field_group', $group_key, $groups[$group_key]);
  $form_display->save();
}

/**
 * Enable CTA icon fields in the edit form + field group.
 */
function paragraph_media_with_text_update_9008(): void {
  $paragraph_type = ParagraphsType::load('media_with_text');
  if (!$paragraph_type) {
    return;
  }

  _paragraph_media_with_text_add_fields($paragraph_type);
  _paragraph_media_with_text_enable_fields_in_form_display($paragraph_type);
  _paragraph_media_with_text_enable_fields_in_view_display($paragraph_type);

  // Re-apply field grouping (Field Group) if available.
  paragraph_media_with_text_update_9006();
}

