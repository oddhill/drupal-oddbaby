{
  "name": "@oddhill/oddbaby",
  "version": "1.0.0",
  "description": "A starter theme for Drupal 8+.",
  "main": "src/main.js",
  "repository": "https://www.github.com/oddhill/drupal-oddbaby",
  "author": "Christoffer Palm <christoffer.palm@oddhill.se>",
  "license": "MIT",
  "engines": {
    "node": "22.*"
  },
  "scripts": {
    "start": "node scripts/generate-component-libraries.js && NODE_ENV=development vite",
    "build": "node scripts/generate-component-libraries.js && NODE_ENV=production vite build",
    "figma:sync": "node figma/generate-scss.js",
    "eslint": "eslint ./src",
    "eslint-ci": "eslint ./src --format junit -o ./reports/eslint.xml",
    "stylelint": "stylelint ./src/scss/**/*.scss",
    "stylelint-ci": "stylelint ./src/scss/**/*.scss --custom-formatter=./node_modules/stylelint-junit-formatter > ./reports/stylelint.xml"
  },
  "browserslist": "defaults",
  "dependencies": {
    "bootstrap": "^5.1.0",
    "embla-carousel": "^9.0.0-rc01",
    "embla-carousel-accessibility": "^9.0.0-rc01",
    "embla-carousel-auto-height": "^9.0.0-rc01",
    "embla-carousel-autoplay": "^9.0.0-rc01",
    "normalize.css": "^8.0.0",
    "vite": "^8.0.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "autoprefixer": "^10.3.1",
    "eslint": "^8.38.0",
    "eslint-plugin-import": "^2.0.0",
    "postcss": "^8.3.6",
    "prettier": "^2.3.2",
    "sass": "^1.37.5",
    "stylelint": "^13.13.1",
    "stylelint-config-sass-guidelines": "^8.0.0",
    "stylelint-junit-formatter": "^0.2.1",
    "typescript": "^5.0.4"
  }
}
