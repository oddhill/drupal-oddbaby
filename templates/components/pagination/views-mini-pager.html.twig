{#
/**
 * @file
 * Drupal mini pager integration for pagination component.
 *
 * INSTALLATION:
 * To activate this custom pagination for all Drupal mini pagers:
 * 1. Remove .example from filename
 * 2. Clear Drupal cache: drush cr
 *
 * Note: Mini pagers only show previous/next buttons, not page numbers.
 *
 * Available variables:
 * - heading_id: Pagination heading ID.
 * - items: List of pager items (previous and next only).
 * - current: The page number of the current page.
 *
 * @see template_preprocess_views_mini_pager()
 */
#}

{% include '@oddbaby/templates/components/pagination/pagination.html.twig' with {
  items: items,
  current: current,
  heading_id: heading_id,
} %}
